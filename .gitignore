# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies / build
node_modules/
.next/
.turbo/
dist/
.open-next/
.wrangler/

# OS / editor
.DS_Store
Thumbs.db

# Writing prompt eval (M6-B5): reports, and examiner-marked scripts that can't be committed
supabase/functions/_eval/results/
supabase/functions/_eval/writing_essays.local.json
# Speaking eval (M7-B5): people's recordings and their manifest stay local, never committed
supabase/functions/_eval/speaking/recordings/
supabase/functions/_eval/speaking/recordings.local.json

# Markdown stays local (plans, logs, docs, notes): only README.md files are committed.
*.md
!README.md
!**/README.md
