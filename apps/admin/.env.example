# Copy to .env.local. All values are PUBLIC (they end up in the browser bundle).
# Supabase: the same project and keys as the student app (Project Settings -> API Keys).
# Never put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Copy to .env.local. Optional and public: Sentry DSN for the admin project (M0-I2).
# Left empty, nothing is sent; on localhost Sentry stays off even when set.
NEXT_PUBLIC_SENTRY_DSN=
