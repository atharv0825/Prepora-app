# Copy to .env.local and fill in. Both values are PUBLIC (they end up in the browser bundle);
# Row Level Security protects the data. Never put the service-role / secret key in this app.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sentry + PostHog (M0-I2). Optional and public. Left empty, nothing is sent; on localhost both
# SDKs stay off even when set. Sentry → Project Settings → Client Keys (DSN).
# PostHog → Project settings → Project API key; host is https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Writing (M6-C3): "1" answers score-writing / ocr-writing with mock feedback, so the Writing
# screens work before the AI functions do. Development only; removed in M6-I1.
NEXT_PUBLIC_WRITING_MOCKS=
