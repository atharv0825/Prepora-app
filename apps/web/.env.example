# Copy to .env.local and fill in. Both values are PUBLIC (they end up in the browser bundle);
# Row Level Security protects the data. Never put the service-role / secret key in this app.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
