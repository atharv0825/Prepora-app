# Copy to supabase/.env (gitignored). Read by the Supabase CLI for env(...) values in config.toml.
# Google OAuth for LOCAL sign-in: a Google Cloud OAuth client (Web application) whose
# "Authorized redirect URIs" include http://127.0.0.1:54321/auth/v1/callback.
# Can be the same client as staging, or a separate "Prepora local" client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
